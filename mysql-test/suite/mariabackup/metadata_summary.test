--source include/have_debug.inc
--source include/have_innodb.inc

let $basedir=$MYSQLTEST_VARDIR/tmp/backup;

CREATE TABLE t(a varchar(60)) ENGINE INNODB;
INSERT INTO t VALUES(1);

--disable_result_log
exec $XTRABACKUP --defaults-file=$MYSQLTEST_VARDIR/my.cnf  --backup --parallel=10 --target-dir=$basedir;
--enable_result_log

--error 1
exec $XTRABACKUP --prepare --binlog-info=1 --target-dir=$basedir --dbug=+d,mariabackup_fail_metadata;

DROP TABLE t;

# Cleanup
rmdir $basedir;

