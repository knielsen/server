################################################################################################
# Test OID that does not match the Kaa prefix to ensure no regression for non-kaa client certs #
################################################################################################


CREATE USER 'nonkaaoid'@'localhost';

ALTER USER 'nonkaaoid'@'localhost' REQUIRE SUBJECT '/CN=nonkaa';
connect (con_nonkaaoid,localhost,nonkaaoid);
SELECT 1;

connection default;

DROP USER 'nonkaaoid'@'localhost';

disconnect con_nonkaaoid;
