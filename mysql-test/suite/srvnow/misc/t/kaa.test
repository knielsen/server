#########################################################
# Test Kaa instance name and OID support                #
#########################################################


CREATE USER 'kaa4glide'@'localhost';

# enable app node kaa authentication for instance "customer1" and test
ALTER USER 'kaa4glide'@'localhost' REQUIRE SUBJECT 'customer1<1.3.6.1.4.1.56079.2.2.2>';
connect (con_kaa4glide,localhost,kaa4glide);
SELECT 1;

connection default;

# change the authentication to some other OID and see that it fails
ALTER USER 'kaa4glide'@'localhost' REQUIRE SUBJECT 'customer1<1.3.6.1.4.1.56079.2.2.999>';
--replace_regex /.*mysqld\.1\.sock.*/SOCKIGNORED/
--error 1045
connect (con_kaa4glide999,localhost,kaa4glide);

# back to app node OID but different instance name, and see that it fails
ALTER USER 'kaa4glide'@'localhost' REQUIRE SUBJECT 'customer222<1.3.6.1.4.1.56079.2.2.2>';
--replace_regex /.*mysqld\.1\.sock.*/SOCKIGNORED/
--error 1045
connect (con_kaa4glide222,localhost,kaa4glide);

# back to original app node and test
ALTER USER 'kaa4glide'@'localhost' REQUIRE SUBJECT 'customer1<1.3.6.1.4.1.56079.2.2.2>';
connect (con_kaa4glideretest,localhost,kaa4glide);

disconnect con_kaa4glide;
disconnect con_kaa4glideretest;
connection default;
DROP USER 'kaa4glide'@'localhost';
