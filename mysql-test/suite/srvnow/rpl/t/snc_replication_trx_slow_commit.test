--source include/have_innodb.inc
--source include/have_binlog_format_mixed.inc
--source include/master-slave.inc

--connection slave
--source include/stop_slave.inc
SET STATEMENT sql_log_bin=0 FOR
  ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
SET @old_threads= @@GLOBAL.slave_parallel_threads;
SET GLOBAL slave_parallel_threads= 4;
SET @old_mode= @@GLOBAL.slave_parallel_mode;
SET GLOBAL slave_parallel_mode= optimistic;
CHANGE MASTER TO master_use_gtid= slave_pos;
--source include/start_slave.inc

SET @old_slow_commit= @@GLOBAL.snc_replication_trx_slow_commit;
SET GLOBAL snc_replication_trx_slow_commit= 0.5;

--connection master
CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t2 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 0), (2, 0), (3, 0), (4, 0);
INSERT INTO t2 VALUES (1, 1), (2, 1), (3, 1), (4, 1);
--source include/save_master_gtid.inc

--connection slave
--source include/sync_with_master_gtid.inc

# Block temporarily a row to delay replication and trigger the
# reporting of slow commit.
--connection slave1
BEGIN;
UPDATE t2 SET b=3 WHERE a=2;

--connection master
UPDATE t1 SET b=2 WHERE a=1;
UPDATE t1 SET b=2 WHERE a=2;
BEGIN;
UPDATE t1 SET b=2 WHERE a=3;
UPDATE t2 SET b=2 WHERE a=2;
INSERT INTO t1 VALUES (5, 2);
COMMIT;
BEGIN;
UPDATE t1 SET b=2 WHERE a=4;
UPDATE t2 SET b=2 WHERE a=4;
COMMIT;
INSERT INTO t1 VALUES (6, 2);
INSERT INTO t2 VALUES (7, 2);

--source include/save_master_gtid.inc

# Delay replication for a bit longer than the configured slow limit.
--connection slave
SELECT SLEEP(0.8);
--connection slave1
ROLLBACK;
--connection slave
--source include/sync_with_master_gtid.inc
SELECT * FROM t1 ORDER BY a;
SELECT * FROM t2 ORDER BY a;

# Check for the expected output in the server error log.
--let SEARCH_FILE=$MYSQLTEST_VARDIR/log/mysqld.2.err
--let SEARCH_PATTERN= Slave SQL thread: Slow commit [(][0-9]+ usec[)], GTIDs: 0-1-7 0-1-8 0-1-9 0-1-10
--source include/search_pattern_in_file.inc


# Cleanup.
--connection slave
--source include/stop_slave.inc
SET GLOBAL snc_replication_trx_slow_commit= @old_slow_commit;
SET GLOBAL slave_parallel_mode= @old_mode;
SET GLOBAL slave_parallel_threads= @old_threads;
--source include/start_slave.inc

--connection master
DROP TABLE t1, t2;

--source include/rpl_end.inc
