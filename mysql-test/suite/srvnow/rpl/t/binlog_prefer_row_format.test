--source include/have_innodb.inc
--source include/master-slave.inc

connection master;

select @@binlog_format;

# A regular table
# Expected record format is the same as the default binlog format
CREATE TABLE t1 (a INT) ENGINE=Innodb;
INSERT INTO t1 VALUES (1);

# A table with row format preferred
# Row -> Row, Mixed -> Row, Statement -> Statement
CREATE TABLE t2 (a INT) ENGINE=Innodb COMMENT '[sn:prefer_row_binlog_format]';
INSERT INTO t2 VALUES (1);

ALTER TABLE t2 COMMENT '';
# Remove special comment
# Expected record format is the same as the default binlog format
INSERT INTO t2 VALUES (2);

# Add special comment back
# Row -> Row, Mixed -> Row, Statement -> Statement
ALTER TABLE t2 COMMENT '[sn:prefer_row_binlog_format]';
INSERT INTO t2 VALUES (3);

# Any other comments should not change the binlog format preference
ALTER TABLE t2 COMMENT 'Some other comment';
INSERT INTO t2 VALUES (4);

# Force row format
# Row -> Row, Mixed -> Row, Statement -> Row
CREATE TABLE t3 (a INT) ENGINE=Innodb COMMENT '[sn:force_row_binlog_format]';
INSERT INTO t3 VALUES (1);

DROP TABLE t1;
DROP TABLE t2;
DROP TABLE t3;

connection slave;
source include/show_binlog_events.inc;

--source include/rpl_end.inc
