slave-bin.000001	#	Xid	#	#	COMMIT /* XID */
connection slaveA;
UNLOCK TABLES;
SELECT master_gtid_wait('0-1-5,7-1-1');
master_gtid_wait('0-1-5,7-1-1')
0
