connection slaveA;
SET GLOBAL snc_slave_max_synchronized_domain_id= @old_snc_slave_max_synchronized_domain_id;
connection master;
SET GLOBAL snc_master_ddl_repl_subdomain_id= @old_snc_master_ddl_repl_subdomain_id;
DROP TABLE t1;
DROP TABLE t2;
include/rpl_end.inc
