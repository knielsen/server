--source include/have_innodb.inc
--source include/have_sequence.inc
--source include/have_binlog_format_mixed.inc
--source include/master-slave.inc

--connection slave
--source include/stop_slave.inc
SET STATEMENT sql_log_bin=0 FOR
  ALTER TABLE mysql.gtid_slave_pos ENGINE=InnoDB;
SET @old_threads= @@GLOBAL.slave_parallel_threads;
SET GLOBAL slave_parallel_threads= 20;
SET @old_mode= @@GLOBAL.slave_parallel_mode;
SET GLOBAL slave_parallel_mode= aggressive;
SET @old_retries= @@GLOBAL.slave_transaction_retries;
SET GLOBAL slave_transaction_retries= 10;
# Don't want lock wait timeouts to interfere with our carefully controlled
# worker thread scheduling.
SET @old_timeout= @@GLOBAL.innodb_lock_wait_timeout;
SET GLOBAL innodb_lock_wait_timeout= 1000000;
CHANGE MASTER TO master_use_gtid= slave_pos;
--source include/start_slave.inc

--connection master
CREATE TABLE t1 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
CREATE TABLE t2 (a INT PRIMARY KEY, b INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, 0), (2, 0), (3, 0), (4, 0);
INSERT INTO t2 VALUES (1, 0), (2, 0), (3, 0), (4, 0);
--source include/save_master_gtid.inc

--connection slave
--source include/sync_with_master_gtid.inc


# Test with 3 transactions T1, T2, T3, that T3 can conflict with T1 and
# that T3 can still retry without waiting for T2 to commit first.

# Couple blocking transactions to control worker thread scheduling.
--connection slave1
BEGIN;
SELECT * FROM t1 WHERE a=1 FOR UPDATE;

--connection server_2
BEGIN;
SELECT * FROM t1 WHERE a=2 FOR UPDATE;

--connection slave
--let $retry1= query_get_value(SHOW STATUS LIKE 'Slave_retried_transactions', Value, 1)

--connection master
# T1.
BEGIN;
UPDATE t1 SET b=1 WHERE a=1;
UPDATE t2 SET b=1 WHERE a=1;
COMMIT;

# T2.
BEGIN;
UPDATE t1 SET b=2 WHERE a=2;
UPDATE t2 SET b=2 WHERE a=2;
COMMIT;

# T3.
BEGIN;
UPDATE t2 SET b=3 WHERE a=1;
UPDATE t2 SET b=3 WHERE a=2;
UPDATE t1 SET b=3 WHERE a=3;
COMMIT;

--connection slave
# Wait for T3 to have obtained the conflicting lock before releasing T1.
--let $wait_condition= SELECT COUNT(*) = 1 FROM information_schema.processlist WHERE state = "Waiting for prior transaction to commit"
--source include/wait_condition.inc

# Release T1 to run and deadlock kill T2.
--connection slave1
ROLLBACK;
# Now temporarily block T3 so we can see in the processlist when it has
# started its retry.
BEGIN;
SELECT * FROM t1 WHERE a=3 FOR UPDATE;

--connection slave
# Wait for T3 to have started its first retry.
# Seen by both T2 and T3 waiting in their blocked UPDATE statements.
--let $wait_condition= SELECT COUNT(*) = 2 FROM information_schema.processlist WHERE state = "Updating"
--source include/wait_condition.inc

# Release T3, now that we know it has started its first retry.
--connection slave1
ROLLBACK;

# Release T2 and see that T3 has already retried a second time and will
# conflict and be deadlock killed again.
--connection server_2
ROLLBACK;

--connection master
SELECT * FROM t1 ORDER BY a;
SELECT * FROM t2 ORDER BY a;
--source include/save_master_gtid.inc

--connection slave
--source include/sync_with_master_gtid.inc
SELECT * FROM t1 ORDER BY a;
SELECT * FROM t2 ORDER BY a;

--let $retry2= query_get_value(SHOW STATUS LIKE 'Slave_retried_transactions', Value, 1)
--let $retries= `SELECT $retry2 - $retry1`
--echo Transaction retries: $retries (expected 2)


# Test a transaction that repeatedly conflicts and retries against T1, T2, ...,
# that it eventually gives up and waits for all prior transactions to complete
# before exceeding the slave_transaction_retries maximum.
--connection master
INSERT INTO t1 SELECT 100+seq, 0 FROM seq_1_to_20;
INSERT INTO t2 SELECT 100+seq, 0 FROM seq_1_to_20;
--source include/save_master_gtid.inc

--connection slave
--source include/sync_with_master_gtid.inc

# Temporarily block transactions T1 to T17 on slave to control worker
# thread scheduling.
--let $i= 1
while ($i <= 17) {
  --connect (con$i,127.0.0.1,root,,test,$SERVER_MYPORT_2,)
  BEGIN;
  eval SELECT * FROM t1 WHERE a=100+$i FOR UPDATE;
  inc $i;
}

--connection master
# Transactions T1 to T16 which will be released and deadlock kill T17 one
# by one.
--let $i= 1
while ($i <= 16) {
  BEGIN;
  eval UPDATE t1 SET b=$i WHERE a=100+$i;
  eval UPDATE t2 SET b=$i WHERE a=100+$i;
  COMMIT;
  inc $i;
}

# Transaction T17 which will repeatedly retry after conflicting against
# T1, T2, ... until giving up.
BEGIN;
--let $i= 1
while ($i <= 16) {
  eval UPDATE t2 SET b=17 WHERE a=100+$i;
  inc $i;
}
UPDATE t1 SET b=17 WHERE a=100+17;
UPDATE t2 SET b=17 WHERE a=100+17;
COMMIT;

--connection slave
--let $retry1= query_get_value(SHOW STATUS LIKE 'Slave_retried_transactions', Value, 1)

--let $i= 1
while ($i <= 16) {
  --connection slave
  # Wait for T17 to have obtained the conflicting lock before releasing T$i.
  # Once the amount of retries are exhausted, just wait a small bit of time
  # to help the test be able to trigger any bug in the server code.
  if ($i <= 9) {
    --let $wait_condition= SELECT COUNT(*) = 1 FROM information_schema.processlist WHERE state = "Updating" AND info = "UPDATE t1 SET b=17 WHERE a=100+17";
    --source include/wait_condition.inc
  }
  if ($i > 9) {
    --sleep 0.1
  }
  --let $pre_retry= query_get_value(SHOW STATUS LIKE 'Slave_retried_transactions', Value, 1)

  # Release T$i to deadlock kill T17.
  --connection con$i
  ROLLBACK;
  --disconnect con$i
  --connection slave

  # Wait for T17 to have started its retry.
  # Once the amount of retries are exhausted, just wait a small bit of time
  # to help the test be able to trigger any bug in the server code.
  if ($i <= 9) {
    --let $status_var_comparsion= !=
    --let $status_var= Slave_retried_transactions
    --let $status_var_value= $pre_retry
    --source include/wait_for_status_var.inc
  }
  if ($i > 9) {
    --sleep 0.1
  }
  inc $i;
}

--connection slave
--connection con17
ROLLBACK;

--connection master
SELECT * FROM t1 ORDER BY a;
SELECT * FROM t2 ORDER BY a;
--source include/save_master_gtid.inc

--connection slave
--source include/sync_with_master_gtid.inc
SELECT * FROM t1 ORDER BY a;
SELECT * FROM t2 ORDER BY a;

--let $retry2= query_get_value(SHOW STATUS LIKE 'Slave_retried_transactions', Value, 1)
--let $retries= `SELECT $retry2 - $retry1`
--echo Transaction retries: $retries (expected 9)

# Cleanup.
--connection slave
--source include/stop_slave.inc
SET GLOBAL innodb_lock_wait_timeout= @old_timeout;
SET GLOBAL slave_transaction_retries= @old_retries;
SET GLOBAL slave_parallel_mode= @old_mode;
SET GLOBAL slave_parallel_threads= @old_threads;
--source include/start_slave.inc

--connection master
DROP TABLE t1, t2;

--source include/rpl_end.inc
