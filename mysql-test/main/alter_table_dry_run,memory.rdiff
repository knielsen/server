-# Test that CHECK TABLE ... EXTENDED is OK.
-#
-CHECK TABLE t1 EXTENDED;
-Table	Op	Msg_type	Msg_text
-test.t1	check	status	OK
-DROP TABLE t1;
 CREATE TABLE t2 (a INT, b DOUBLE) DEFAULT CHARSET=utf8;
 SHOW CREATE TABLE t2;
 Table	Create Table
@@ -35,7 +10,7 @@
