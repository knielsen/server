-  `a` int(11) DEFAULT NULL,
-  `b` text DEFAULT NULL
-) ENGINE=<ENGINE> <CREATE_OPTS>
-#
-# Test addition of FULLTEXT index.
-#
-ALTER TABLE t1 ADD FULLTEXT INDEX (b(64)), DRY_RUN;
-ERROR HY000: INPLACE ALTER executed with DRY_RUN flag, no changes applied; ALTER flags: 0x8; Partition flags: 0x0; Handler flags: 0x800000400
-SHOW CREATE TABLE t1;
-Table	Create Table
-t1	CREATE TABLE `t1` (
-  `a` int(11) DEFAULT NULL,
-  `b` text DEFAULT NULL
-) ENGINE=<ENGINE> <CREATE_OPTS>
